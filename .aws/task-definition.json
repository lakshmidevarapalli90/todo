{
    "family": "todos-app",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::851725375292:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::851725375292:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "todos-backend",
            "image": "851725375292.dkr.ecr.eu-west-2.amazonaws.com/todos-backend:latest",
            "portMappings": [
                {
                    "containerPort": 5000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "DB_HOST",
                    "value": "todos-db.crggweq26k9z.eu-west-2.rds.amazonaws.com"
                },
                {
                    "name": "DB_PORT",
                    "value": "5432"
                },
                {
                    "name": "DB_NAME",
                    "value": "${DB_NAME}"
                },
                {
                    "name": "DB_USER",
                    "value": "${DB_USER}"
                },
                {
                    "name": "DB_PASSWORD",
                    "value": "${DB_PASSWORD}"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/todos-app",
                    "awslogs-region": "eu-west-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}